PORT=3001
NODE_ENV=development
# Orígenes permitidos para CORS en producción (separados por coma)
CLIENT_ORIGIN=http://localhost:5173

# ----- Comunidad (amigos y notificaciones) -----
# Archivo SQLite con cuentas, amigos y suscripciones push. En Render debe estar
# en un disco persistente (p. ej. /var/data/runrun.db) o se borrará en cada despliegue.
COMMUNITY_DB_PATH=./data/runrun.db
# Claves VAPID para Web Push (genéralas con: npx web-push generate-vapid-keys).
# Si faltan, el servidor crea unas y las guarda en la base de datos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exigen los servicios push (mailto: o https:)
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
