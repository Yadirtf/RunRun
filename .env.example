# Servidor (server/)
PORT=3001
NODE_ENV=production
# Solo si el cliente se sirve desde OTRO dominio (p. ej. Vercel + servidor en Render).
# Varios orígenes separados por comas. Vacío = mismo origen (recomendado).
CLIENT_ORIGIN=
# Máximo de salas simultáneas
MAX_ROOMS=500

# Cliente (client/), solo si el servidor está en otro dominio:
# VITE_SERVER_URL=https://tu-servidor.onrender.com
